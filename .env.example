# ---- Storage ----
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_documents

# ---- Embeddings: huggingface | openai | hash (hash = offline test embedder, low quality) ----
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- LLM: auto | gemini | openai | ollama | extractive ----
# auto = gemini if GEMINI_API_KEY is set, else openai if OPENAI_API_KEY is set, else extractive (offline, no key)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- Chunking ----
DEFAULT_CHUNKING_STRATEGY=fixed
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SEMANTIC_DISTANCE_THRESHOLD=0.35

# ---- Retrieval ----
HYBRID_ALPHA=0.6
FUSION_METHOD=rrf
TOP_K=4
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_COSINE_SCORE=0.20
MIN_RERANK_SCORE=0.05

# ---- API ----
API_PORT=8000
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
